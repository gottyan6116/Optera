# Known production HTTPS origin. Leave blank for preview (robots disallows indexing).
NEXT_PUBLIC_SITE_URL=
# Optional real GA4 measurement ID. Analytics loads only after opt-in.
NEXT_PUBLIC_GA4_ID=
# Server-only HTTPS receiver accepting JSON and returning 2xx after durable acceptance.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
# Set true only AFTER replacing privacy draft with confirmed business details.
CONTACT_PRIVACY_READY=false
# Optional real Google Forms fallback; never use a made-up URL.
GOOGLE_FORM_URL=
